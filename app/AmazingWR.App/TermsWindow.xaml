<Window x:Class="AmazingWR.App.TermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" Height="310" MinWidth="390" MinHeight="310"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="9">
        <Border x:Name="DialogBorder" Background="#15171A" BorderBrush="#353A42" BorderThickness="1" CornerRadius="20" Padding="20">
            <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.42" Color="#000000"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AmzWR" Foreground="#969BA3" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="DialogTitle" Text="Условия использования" Foreground="#F4F5F6" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Content="×" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="20" Foreground="#A7ABB1" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Close_Click">
                        <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></ControlTemplate></Button.Template>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,15,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="DialogBody" Foreground="#C3C6CB" FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
                </ScrollViewer>
                <Button x:Name="OkButton" Grid.Row="2" Content="Понятно" Width="100" Height="34" HorizontalAlignment="Right" Background="#E5E7EA" Foreground="#111318" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="Close_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
