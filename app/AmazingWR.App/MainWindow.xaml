                        <Button x:Name="PhonebookNavButton" Content="Телефонная книга" Style="{StaticResource RoundButton}" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" Padding="15,12" Margin="0,8,0,0" Click="Phonebook_Click"/>
                        <Button x:Name="SettingsNavButton" Content="Настройки" Style="{StaticResource RoundButton}" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" Padding="15,12" Margin="0,8,0,0" Click="Settings_Click"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Grid Margin="0,0,0,12"><TextBlock Text="ЯЗЫК" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><ComboBox x:Name="LanguageBox" Style="{StaticResource InputComboBox}" Width="76" HorizontalAlignment="Right" SelectionChanged="Language_Changed"><ComboBoxItem Content="RU"/><ComboBoxItem Content="EN"/></ComboBox></Grid>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,18,0,12">
