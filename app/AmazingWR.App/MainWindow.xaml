                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="14" Padding="26" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}"/><TextBlock Text="ОБЫЧНЫЕ УВЕДОМЛЕНИЯ" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="9,0,0,0"/></StackPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="MainStatus" Text="Выключено" FontSize="32" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal"><ToggleButton x:Name="MonitoringToggle" Style="{StaticResource Switch}" Checked="Monitoring_Checked" Unchecked="Monitoring_Unchecked"/><TextBlock x:Name="MasterToggleLabel" Text="Все функции выключены" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
