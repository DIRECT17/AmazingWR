        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource CardBgBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/>
