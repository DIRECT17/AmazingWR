                    <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,42">
                            <Border Width="48" Height="48" CornerRadius="13" Background="#0A0A0C" BorderBrush="#34343C" BorderThickness="1" Padding="9,0"><Viewbox><Canvas Width="26" Height="16"><Path Data="{StaticResource BrandCatGeometry}" Fill="#F4F5F6"/></Canvas></Viewbox></Border>
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="AmazingWR" FontSize="18" FontWeight="Black"/><Button Style="{StaticResource GitHubLink}" HorizontalAlignment="Left" Margin="1,4,0,0" ToolTip="https://github.com/DIRECT17/AmazingWR" Click="GitHub_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GitHubIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Text="GitHub" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
                        </StackPanel>
                        <Button x:Name="OverviewNavButton" Content="Обзор" Style="{StaticResource RoundButton}" HorizontalContentAlignment="Left" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" Padding="15,12" Click="Overview_Click"/>
