<Window x:Class="AmazingWR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AmzWR" Icon="pack://application:,,,/AmazingWR;component/amzwr-icon.png" Height="620" Width="520" MinHeight="600" MinWidth="500"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI" ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Geometry x:Key="BrandMarkGeometry">M 2,17 H 4 V 15 H 6 V 16 H 7 V 18 H 9 V 20 H 21 V 19 H 23 V 17 H 25 V 10 H 23 V 8 H 21 V 6 H 19 V 3 H 17 V 7 H 15 V 8 H 13 V 7 H 11 V 3 H 9 V 6 H 7 V 8 H 5 V 10 H 3 V 15 H 2 Z</Geometry>
        <Geometry x:Key="BrandEyesGeometry">M 10,14 H 13 V 15 H 10 Z M 17,14 H 20 V 15 H 17 Z</Geometry>
        <Geometry x:Key="HeroCatGeometry">M 30,43 H 34 V 29 H 38 V 22 H 43 V 16 H 48 V 9 H 54 V 20 H 61 V 23 H 67 V 19 H 72 V 9 H 78 V 15 H 83 V 22 H 88 V 29 H 92 V 43 H 89 V 48 H 84 V 52 H 75 V 55 H 64 V 53 H 57 V 50 H 50 V 48 H 43 V 46 H 37 V 44 H 31 V 47 H 8 V 51 H 3 V 36 H 8 V 43 Z</Geometry>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#090A0D"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#0E1013"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#15171A"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#1C1F23"/>
        <SolidColorBrush x:Key="RowBgBrush" Color="#202328"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#262A30"/>
        <SolidColorBrush x:Key="BorderThemeBrush" Color="#353A42"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3B4048"/>
        <SolidColorBrush x:Key="SwitchTrackBrush" Color="#3A3F47"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F5F6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E5E7EA"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#101114"/>
        <SolidColorBrush x:Key="PositiveBrush" Color="#35D07F"/>
        <SolidColorBrush x:Key="NegativeBrush" Color="#FF5C63"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <SolidColorBrush x:Key="Panel" Color="#15171A"/>
        <SolidColorBrush x:Key="Panel2" Color="#1C1F23"/>
        <SolidColorBrush x:Key="Muted" Color="#A7ABB1"/>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="42"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="ButtonContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/><Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonBgBrush}"/><Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="QuietLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="16,9"/><Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></MultiTrigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabBorder" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="52"/><Setter Property="Height" Value="30"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid><Border x:Name="track" Background="{DynamicResource SwitchTrackBrush}" CornerRadius="15"/><Ellipse x:Name="knob" Width="22" Height="22" Fill="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Left" Margin="4,0,0,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/><Setter TargetName="knob" Property="Fill" Value="{DynamicResource WindowBgBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="track" Property="Opacity" Value="0.35"/><Setter TargetName="knob" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="CheckBoxFrame" Width="17" Height="17" CornerRadius="5" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="CheckGlyph" Data="M 3,8 L 6.5,11.5 L 14,4" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/></Border><ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBoxFrame" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,12"/><Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/><Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource CardBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/></Trigger></Style.Triggers></Style></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/><Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter x:Name="SelectionBox" Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False"/><ToggleButton Grid.Column="1" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></ToggleButton></Grid><Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Fade"><Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,4,0,0"><ScrollViewer MaxHeight="240" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Activation gate -->
        <Grid x:Name="ActivationView" Visibility="Visible" Background="{DynamicResource WindowBgBrush}">
            <Border Width="440" Padding="32" Background="{DynamicResource CardBgBrush}" CornerRadius="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.38" Color="#000000"/></Border.Effect>
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="17" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Padding="10"><Viewbox><Grid Width="27" Height="23"><Path Data="{StaticResource BrandMarkGeometry}" Fill="{DynamicResource AccentTextBrush}"/><Path Data="{StaticResource BrandEyesGeometry}" Fill="{DynamicResource AccentBrush}"/></Grid></Viewbox></Border>
                    <TextBlock Text="AmzWR" FontSize="12" FontWeight="Bold" Margin="0,19,0,0"/>
                    <TextBlock Text="Вход в приложение" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    <TextBlock Text="Введите Telegram ID из Telegram-бота, чтобы войти в приложение." Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,9,0,19"/>
                    <TextBlock Text="TELEGRAM ID" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,8"/>
                    <TextBox x:Name="TelegramIdBox" Style="{StaticResource Input}" ToolTip="Ваш ID из Telegram-бота"/>
                    <CheckBox x:Name="ActivationAutoLoginToggle" Content="Входить автоматически при запуске" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,14,0,0" Checked="AutoLogin_Changed" Unchecked="AutoLogin_Changed"/>
                    <TextBlock x:Name="ActivationMessage" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <Button x:Name="ConnectButton" Content="Запросить подключение" Style="{StaticResource RoundButton}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="#11151A" FontWeight="SemiBold" Margin="0,22,0,0" Click="Connect_Click"/>
                    <Button Content="✈ Получить доступ в Telegram" Style="{StaticResource RoundButton}" Background="#229ED9" BorderBrush="#229ED9" Foreground="White" FontWeight="SemiBold" Margin="0,17,0,0" Click="GetAccess_Click"/>
                    <Button Content="Условия использования" Style="{StaticResource QuietLinkButton}" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,2,0,0" Click="Terms_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main application -->
        <Grid x:Name="AppView" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image x:Name="AppBackgroundImage" Grid.ColumnSpan="2" Stretch="UniformToFill" Opacity="0.2" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="0,0,1,0" Padding="22,24">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,42">
                            <Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource AccentBrush}" Padding="8"><Viewbox><Grid Width="27" Height="23"><Path Data="{StaticResource BrandMarkGeometry}" Fill="{DynamicResource AccentTextBrush}"/><Path Data="{StaticResource BrandEyesGeometry}" Fill="{DynamicResource AccentBrush}"/></Grid></Viewbox></Border>
                            <StackPanel Margin="12,2,0,0"><TextBlock Text="AmzWR" FontSize="12" FontWeight="Bold"/><TextBlock Text="GAME ASSISTANT" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
                        </StackPanel>
                        <Button x:Name="OverviewNavButton" Content="Обзор" Style="{StaticResource RoundButton}" HorizontalContentAlignment="Left" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" Padding="15,12" Click="Overview_Click"/>
                        <Button x:Name="HistoryNavButton" Content="История" Style="{StaticResource RoundButton}" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" Padding="15,12" Margin="0,8,0,0" Click="History_Click"/>
                        <Button x:Name="PhonebookNavButton" Content="Телефонная книга" Style="{StaticResource RoundButton}" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" Padding="15,12" Margin="0,8,0,0" Click="Phonebook_Click"/>
                        <Button x:Name="SettingsNavButton" Content="Настройки" Style="{StaticResource RoundButton}" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" Padding="15,12" Margin="0,8,0,0" Click="Settings_Click"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Grid Margin="0,0,0,10"><TextBlock x:Name="ThemeModeLabel" Text="Тема: ночь" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><ToggleButton x:Name="ThemeToggle" Style="{StaticResource Switch}" Width="44" Height="26" HorizontalAlignment="Right" Checked="Theme_Changed" Unchecked="Theme_Changed"/></Grid>
                        <Grid Margin="0,0,0,12"><TextBlock Text="ЯЗЫК" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><ComboBox x:Name="LanguageBox" Style="{StaticResource InputComboBox}" Width="76" HorizontalAlignment="Right" SelectionChanged="Language_Changed"><ComboBoxItem Content="RU"/><ComboBoxItem Content="EN"/></ComboBox></Grid>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,18,0,12">
                            <StackPanel Orientation="Horizontal"><Ellipse x:Name="BridgeDot" Width="11" Height="11" Fill="{DynamicResource NegativeBrush}" VerticalAlignment="Center" Margin="0,0,11,0"><Ellipse.Effect><DropShadowEffect Color="#FF5C63" BlurRadius="9" ShadowDepth="0" Opacity="0.65"/></Ellipse.Effect></Ellipse><StackPanel><TextBlock Text="СЕРВЕР" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="BridgeStatus" Text="Нет соединения" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel></StackPanel>
                        </Border>
                        <Button Content="✈ Поддержка" Style="{StaticResource RoundButton}" HorizontalContentAlignment="Left" Background="{DynamicResource Surface2Brush}" BorderBrush="#229ED9" Foreground="#229ED9" Padding="13,9" Margin="0,0,0,8" Click="Support_Click"/>
                        <Button Content="Выйти из аккаунта" Style="{StaticResource RoundButton}" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="{DynamicResource NegativeBrush}" Foreground="{DynamicResource NegativeBrush}" Padding="13,9" Click="Logout_Click"/>
                        <StackPanel Margin="13,7,0,0"><TextBlock x:Name="VersionLabel" Text="Версия · проверка…" Foreground="{DynamicResource Muted}" FontSize="10"/><Button x:Name="UpdateButton" Content="✨ Обновить AmzWR" Style="{StaticResource RoundButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontWeight="SemiBold" Margin="-13,8,-13,0" Visibility="Collapsed" Click="UpdateApp_Click"/></StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="34,28,34,28">
                <Grid x:Name="DashboardView" Visibility="Visible">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <StackPanel><TextBlock Text="Панель управления" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Состояние функций и подключения" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Right" Margin="0,0,12,0"><TextBlock x:Name="ProfileName" Text="Telegram аккаунт" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="ProfileHandle" Text="@username" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/><TextBlock x:Name="ProfileGameServer" Text="Сервер —" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel>
                            <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource ButtonBgBrush}" ClipToBounds="True"><Image x:Name="ProfileAvatar" Stretch="UniformToFill"/></Border>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="24" Padding="26" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}"/><TextBlock Text="ОБЫЧНЫЕ УВЕДОМЛЕНИЯ" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="9,0,0,0"/></StackPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="MainStatus" Text="Выключено" FontSize="32" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal"><ToggleButton x:Name="MonitoringToggle" Style="{StaticResource Switch}" Checked="Monitoring_Checked" Unchecked="Monitoring_Unchecked"/><TextBlock x:Name="MasterToggleLabel" Text="Все функции выключены" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" CornerRadius="24" Padding="23" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1">
                            <StackPanel><TextBlock Text="ПОДПИСКА" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock x:Name="SubscriptionStatus" Text="Не активна" FontSize="21" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBlock Text="ОСТАЛОСЬ" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,24,0,5"/><TextBlock x:Name="SubscriptionTime" Text="—" FontSize="26" FontWeight="Light"/></StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="24" Padding="28" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Surface2Brush}" CornerRadius="22" Margin="0,0,26,0" ClipToBounds="True">
                                <Grid>
                                    <Ellipse Width="190" Height="190" Fill="{DynamicResource ButtonBgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                    <Grid Width="214" Height="152" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased">
                                        <Path Data="{StaticResource HeroCatGeometry}" Fill="{DynamicResource PrimaryTextBrush}" Stretch="Fill" Margin="0,6,0,8"/>
                                        <Canvas IsHitTestVisible="False"><Rectangle Canvas.Left="108" Canvas.Top="92" Width="22" Height="9" Fill="{DynamicResource WindowBgBrush}"/><Rectangle Canvas.Left="156" Canvas.Top="92" Width="22" Height="9" Fill="{DynamicResource WindowBgBrush}"/></Canvas>
                                    </Grid>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="12" Padding="10,7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,20,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource PositiveBrush}" VerticalAlignment="Center"/><TextBlock Text="CHATLOG" FontSize="9" FontWeight="SemiBold" Margin="6,0,0,0"/></StackPanel></Border>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="12" Padding="10,7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,16"><TextBlock Text="♡  AmzWR" FontSize="10" FontWeight="SemiBold"/></Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="AMZWR  ·  ТИХИЙ ПОМОЩНИК" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="Поймай кота" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,4"/>
                                <TextBlock Text="Кликай по коту, пока не закончилось время." Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                                <Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="СЧЁТ" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="MiniGameScoreLabel" Text="0" FontSize="19" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ВРЕМЯ" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="MiniGameTimeLabel" Text="20" FontSize="19" FontWeight="SemiBold"/></StackPanel></Grid>
                                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="14" Padding="6" Margin="0,0,0,9"><Canvas x:Name="MiniGameCanvas" Height="82" ClipToBounds="True"><Button x:Name="MiniGameTarget" Content="🐈" FontSize="23" Width="48" Height="48" Padding="0" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" Visibility="Collapsed" Canvas.Left="0" Canvas.Top="0" Click="MiniGameTarget_Click"/></Canvas></Border>
                                <TextBlock x:Name="MiniGameStatusLabel" Text="Готов сыграть?" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,8"/>
                                <Button x:Name="MiniGameStartButton" Content="Начать игру" Style="{StaticResource RoundButton}" HorizontalAlignment="Stretch" Click="MiniGameStart_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="HistoryView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,22"><StackPanel><TextBlock Text="История" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="События сохраняются на сервере и доступны после перезапуска." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,5,0,0"/></StackPanel><Button Content="↻ Обновить" Style="{StaticResource RoundButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" Click="RefreshHistory_Click"/></Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="HistoryAllButton" Content="Все" Tag="Все" Style="{StaticResource RoundButton}" Padding="15,8" Margin="0,0,8,0" Click="HistoryFilter_Click"/>
                        <Button x:Name="HistoryNeedsButton" Content="Нужды" Tag="Нужды" Style="{StaticResource RoundButton}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" Padding="15,8" Margin="0,0,8,0" Click="HistoryFilter_Click"/>
                        <Button x:Name="HistoryBoothButton" Content="Павильон" Tag="Павильон" Style="{StaticResource RoundButton}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" Padding="15,8" Margin="0,0,8,0" Click="HistoryFilter_Click"/>
                        <Button x:Name="HistoryPhoneButton" Content="Телефон" Tag="Телефон" Style="{StaticResource RoundButton}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" Padding="15,8" Click="HistoryFilter_Click"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="24" Padding="18" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1">
                        <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource RowBgBrush}" CornerRadius="14" Padding="16,13" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Top"/><TextBlock Text="{Binding Category}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top" Grid.Column="1"/><TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                </Grid>
                <Grid x:Name="PhonebookView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,22"><StackPanel><TextBlock Text="Телефонная книга" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Общая книга текущего сервера · контакты разделены по серверам" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,5,0,0"/></StackPanel><Button Content="↻ Обновить" Style="{StaticResource RoundButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" Click="RefreshPhonebook_Click"/></Grid>
                    <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="19" Padding="15" Margin="0,0,0,16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="25" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,2"/><TextBox x:Name="PhonebookSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" VerticalContentAlignment="Center" ToolTip="Поиск по имени или номеру" TextChanged="PhonebookSearch_Changed"/><TextBlock x:Name="PhonebookSearchPlaceholder" Grid.Column="1" Text="Поиск по имени или номеру" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/><Button x:Name="PhonebookSearchClearButton" Grid.Column="2" Content="×" Style="{StaticResource RoundButton}" Padding="9,3" VerticalAlignment="Center" Visibility="Collapsed" Click="PhonebookSearchClear_Click"/></Grid>
                    </Border>
                    <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="24" Padding="18" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="14,0,14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock x:Name="PhonebookCount" Text="0 контактов" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="ТЕЛЕФОН" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="9"/><TextBlock Text="ПОСЛЕДНЕЕ ИЗМЕНЕНИЕ" Grid.Column="2" Foreground="{DynamicResource Muted}" FontSize="9"/></Grid>
                            <ListBox x:Name="PhonebookList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate><DataTemplate><Border HorizontalAlignment="Stretch" Background="{DynamicResource RowBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="15" Padding="14,9" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ServerLabel}" Foreground="{Binding ServerBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Grid><TextBlock Text="{Binding Phone}" Grid.Column="1" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding UpdatedAt}" Grid.Column="2" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="Настройки" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Разделы и параметры AmzWR" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
                    <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsTab}">
                        <TabItem x:Name="NotificationsTab" Header="Уведомления">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,16,8,0">
                                <TextBlock Text="Общий переключатель на обзоре включает и выключает все уведомления и расписания." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,0,4,14"/>
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="22" Padding="23" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" Margin="0,0,0,15"><StackPanel><TextBlock Text="ТЕЛЕФОН" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,12"/><Grid Margin="0,7"><TextBlock Text="Уведомления SMS"/><ToggleButton x:Name="SmsToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid><Grid Margin="0,7"><TextBlock Text="Уведомления звонков"/><ToggleButton x:Name="CallsToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid></StackPanel></Border>
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="22" Padding="23" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" Margin="0,0,0,15"><StackPanel><TextBlock Text="ПАВИЛЬОНЫ" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,12"/><Grid Margin="0,7"><TextBlock Text="Уведомления о покупке"/><ToggleButton x:Name="BoothBuyToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid><Grid Margin="0,7"><TextBlock Text="Уведомления о продаже"/><ToggleButton x:Name="BoothSellToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid><Grid Margin="0,7"><TextBlock Text="Напоминание о слёте павильона"/><ToggleButton x:Name="BoothDropToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid><TextBlock Text="Местное время слёта (чч:мм)" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,5"/><TextBox x:Name="BoothDropTimeBox" Style="{StaticResource Input}" Text="06:05" TextChanged="Setting_Changed"/></StackPanel></Border>
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="22" Padding="23" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" Margin="0,0,0,15"><StackPanel><TextBlock Text="НУЖДЫ" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,12"/><Grid Margin="0,7"><TextBlock Text="Уведомления о голоде"/><ToggleButton x:Name="HungerToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid><Grid Margin="0,7"><TextBlock Text="Уведомления о жажде"/><ToggleButton x:Name="ThirstToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid><Grid Margin="0,7"><TextBlock Text="Уведомления о бане"/><ToggleButton x:Name="BathToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid><Grid Margin="0,7"><TextBlock Text="Уведомления о малой нужде"/><ToggleButton x:Name="NeedToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid></StackPanel></Border>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="ProgramTab" Header="Настройки программы">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,16,8,0"><Border Background="{DynamicResource CardBgBrush}" CornerRadius="22" Padding="23" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" Margin="0,0,0,15"><StackPanel><TextBlock Text="ВХОД И ФАЙЛ ЛОГА" Foreground="{DynamicResource Muted}" FontSize="10"/><CheckBox x:Name="SettingsAutoLoginToggle" Content="Входить автоматически при запуске" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,12,0,0" Checked="AutoLogin_Changed" Unchecked="AutoLogin_Changed"/><TextBox x:Name="SettingsLogPath" Style="{StaticResource Input}" Margin="0,12,0,0"/><Button Content="Выбрать файл chatlog.txt" Style="{StaticResource RoundButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ChooseLog_Click"/><TextBlock Text="ФОН ПРИЛОЖЕНИЯ" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,22,0,5"/><TextBlock x:Name="BackgroundImagePathLabel" Text="Изображение не выбрано" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip=""/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Button Content="Выбрать изображение" Style="{StaticResource RoundButton}" Padding="13,8" Click="ChooseBackground_Click"/><Button Content="Сбросить" Style="{StaticResource RoundButton}" Padding="13,8" Margin="9,0,0,0" Click="ResetBackground_Click"/></StackPanel></StackPanel></Border><Border Background="{DynamicResource CardBgBrush}" CornerRadius="22" Padding="23" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1"><StackPanel><TextBlock Text="ВИДИМОСТЬ ВКЛАДОК" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,12"/><CheckBox x:Name="ShowNotificationsTabToggle" Content="Показывать «Уведомления»" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6" Checked="TabVisibility_Changed" Unchecked="TabVisibility_Changed"/><TextBlock Text="Эту вкладку нельзя скрыть, чтобы настройки всегда оставались доступны." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

