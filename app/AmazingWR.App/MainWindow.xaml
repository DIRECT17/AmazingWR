                        </Border>
                        <Button Style="{StaticResource SideButton}" Margin="0,0,0,8" Click="Support_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource TelegramIconGeometry}" Fill="#29A9EB" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="Поддержка" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource SideButton}" Click="Logout_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ExitIconGeometry}" Fill="{DynamicResource AccentBrush}" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="Выйти из аккаунта" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
