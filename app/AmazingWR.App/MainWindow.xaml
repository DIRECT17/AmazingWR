                <TextBlock x:Name="ActivationMessage" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="18"/>
                <Button x:Name="ConnectButton" Content="Войти" Style="{StaticResource RoundButton}" Background="{StaticResource GoldBrush}" BorderBrush="Transparent" BorderThickness="0" Foreground="#1E1E1E" FontWeight="Bold" Margin="0,12,0,0" Click="Connect_Click"/>
                <Button x:Name="TelegramAccessButton" Style="{StaticResource RoundButton}" Background="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource PrimaryTextBrush}" Foreground="#1E1E1E" FontWeight="SemiBold" Margin="0,10,0,0" Click="GetAccess_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource TelegramIconGeometry}" Fill="#229ED9" Width="19" Height="19" Stretch="Uniform"/><TextBlock Text="Получить доступ в Telegram" Foreground="#1E1E1E" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Content="Условия использования" x:Name="TermsLinkButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,6,0,0" Click="Terms_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main application -->
        <Grid x:Name="AppView" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
