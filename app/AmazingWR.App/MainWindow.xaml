                    <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="14" Padding="18" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1">
                        <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" ItemContainerStyle="{StaticResource PlainItem}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
