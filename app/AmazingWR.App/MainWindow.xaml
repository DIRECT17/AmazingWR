                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" CornerRadius="14" Padding="23" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1">
                            <StackPanel><TextBlock Text="ПОДПИСКА" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock x:Name="SubscriptionStatus" Text="Не активна" FontSize="21" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBlock Text="ОСТАЛОСЬ" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,24,0,5"/><TextBlock x:Name="SubscriptionTime" Text="—" FontSize="26" FontWeight="Light"/></StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="14" Padding="28" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="14" Margin="0,0,26,0">
                                <Border.Background><ImageBrush ImageSource="{StaticResource ArtBackground}" Stretch="UniformToFill" AlignmentX="Right"/></Border.Background>
                                <Grid>
                                    <Image Source="{StaticResource ArtBusinessman}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                                    <Border CornerRadius="14" Background="{StaticResource ArtFadeBrush}" Opacity="0.7"/>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="12" Padding="10,7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,20,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource PositiveBrush}" VerticalAlignment="Center"/><TextBlock Text="CHATLOG" FontSize="9" FontWeight="SemiBold" Margin="6,0,0,0"/></StackPanel></Border>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="12" Padding="10,7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,16"><TextBlock Text="♡  AmzWR" FontSize="10" FontWeight="SemiBold"/></Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="AMAZINGWR  ·  ПАВИЛЬОН" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="Статистика торговли" FontSize="24" FontWeight="Bold" Margin="0,10,0,16"/>
                                <Border Background="{DynamicResource RowBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="10" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="StatsDayButton" Content="Сегодня" Tag="day" Style="{StaticResource RoundButton}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" MinHeight="32" Padding="16,6" FontSize="13" Click="StatsPeriod_Click"/>
                                        <Button x:Name="StatsWeekButton" Content="Неделя" Tag="week" Style="{StaticResource RoundButton}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" MinHeight="32" Padding="16,6" FontSize="13" Margin="4,0,0,0" Click="StatsPeriod_Click"/>
                                        <Button x:Name="StatsMonthButton" Content="Месяц" Tag="month" Style="{StaticResource RoundButton}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" MinHeight="32" Padding="16,6" FontSize="13" Margin="4,0,0,0" Click="StatsPeriod_Click"/>
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource RowBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource PositiveBrush}" VerticalAlignment="Center"/><TextBlock Text="Продажи" Foreground="{DynamicResource Muted}" FontSize="13" Margin="8,0,0,0"/></StackPanel>
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,14,0,6"><TextBlock x:Name="StatsSoldAmount" Text="0 ₽" FontSize="30" FontWeight="Bold"/></Viewbox>
                                            <TextBlock x:Name="StatsSoldCount" Text="нет сделок" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource RowBgBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Text="Закупки" Foreground="{DynamicResource Muted}" FontSize="13" Margin="8,0,0,0"/></StackPanel>
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,14,0,6"><TextBlock x:Name="StatsBoughtAmount" Text="0 ₽" FontSize="30" FontWeight="Bold"/></Viewbox>
                                            <TextBlock x:Name="StatsBoughtCount" Text="нет сделок" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Считается по истории сделок в павильоне" Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,14,0,0"/>
