                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="HistoryAllButton" Content="Все" Tag="Все" Style="{StaticResource RoundButton}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" Padding="15,8" Margin="0,0,8,0" Click="HistoryFilter_Click"/>
                        <Button x:Name="HistoryNeedsButton" Content="Нужды" Tag="Нужды" Style="{StaticResource RoundButton}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" Padding="15,8" Margin="0,0,8,0" Click="HistoryFilter_Click"/>
