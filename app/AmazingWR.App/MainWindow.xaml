                                        <TextBlock Style="{StaticResource SettingsHeader}" Text="ТЕЛЕФОН"/>
                                        <Border Style="{StaticResource SettingsRow}"><Grid><TextBlock Text="Уведомления SMS" FontSize="14.5" VerticalAlignment="Center"/><ToggleButton x:Name="SmsToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid></Border>
                                        <Border Style="{StaticResource SettingsRowLast}"><Grid><TextBlock Text="Уведомления звонков" FontSize="14.5" VerticalAlignment="Center"/><ToggleButton x:Name="CallsToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid></Border>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource SettingsCard}"><StackPanel>
                                        <TextBlock Style="{StaticResource SettingsHeader}" Text="ПАВИЛЬОНЫ"/>
                                        <Border Style="{StaticResource SettingsRow}"><Grid><TextBlock Text="Уведомления о покупке" FontSize="14.5" VerticalAlignment="Center"/><ToggleButton x:Name="BoothBuyToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid></Border>
                                        <Border Style="{StaticResource SettingsRow}"><Grid><TextBlock Text="Уведомления о продаже" FontSize="14.5" VerticalAlignment="Center"/><ToggleButton x:Name="BoothSellToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid></Border>
                                        <Border Style="{StaticResource SettingsRow}"><Grid><TextBlock Text="Напоминание о слёте павильона" FontSize="14.5" VerticalAlignment="Center"/><ToggleButton x:Name="BoothDropToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid></Border>
                                        <Border Style="{StaticResource SettingsRowLast}"><Grid><TextBlock Text="Местное время слёта (чч:мм)" FontSize="14.5" VerticalAlignment="Center"/><TextBox x:Name="BoothDropTimeBox" Style="{StaticResource Input}" Width="96" Padding="10,7" FontSize="14.5" TextAlignment="Center" HorizontalAlignment="Right" Text="06:05" TextChanged="Setting_Changed"/></Grid></Border>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource SettingsCard}"><StackPanel>
                                        <TextBlock Style="{StaticResource SettingsHeader}" Text="НУЖДЫ"/>
                                        <Border Style="{StaticResource SettingsRow}"><Grid><TextBlock Text="Уведомления о голоде" FontSize="14.5" VerticalAlignment="Center"/><ToggleButton x:Name="HungerToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid></Border>
                                        <Border Style="{StaticResource SettingsRow}"><Grid><TextBlock Text="Уведомления о жажде" FontSize="14.5" VerticalAlignment="Center"/><ToggleButton x:Name="ThirstToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid></Border>
                                        <Border Style="{StaticResource SettingsRow}"><Grid><TextBlock Text="Уведомления о бане" FontSize="14.5" VerticalAlignment="Center"/><ToggleButton x:Name="BathToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid></Border>
                                        <Border Style="{StaticResource SettingsRowLast}"><Grid><TextBlock Text="Уведомления о малой нужде" FontSize="14.5" VerticalAlignment="Center"/><ToggleButton x:Name="NeedToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/></Grid></Border>
                                    </StackPanel></Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="ProgramTab" Header="Настройки программы">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                                <StackPanel Margin="0,0,10,0">
                                    <Border Style="{StaticResource SettingsCard}"><StackPanel>
                                        <TextBlock Style="{StaticResource SettingsHeader}" Text="ВХОД И ФАЙЛ ЛОГА"/>
                                        <Border Style="{StaticResource SettingsRow}"><Grid><TextBlock Text="Входить автоматически при запуске" FontSize="14.5" VerticalAlignment="Center"/><ToggleButton x:Name="SettingsAutoLoginToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" Checked="AutoLogin_Changed" Unchecked="AutoLogin_Changed"/></Grid></Border>
                                        <Border Style="{StaticResource SettingsRowLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox x:Name="SettingsLogPath" Style="{StaticResource Input}" Padding="13,9" FontSize="13.5" VerticalContentAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Выбрать файл chatlog.txt" Style="{StaticResource RoundButton}" Padding="16,8" Margin="10,0,0,0" Click="ChooseLog_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource SettingsCard}"><StackPanel>
                                        <TextBlock Style="{StaticResource SettingsHeader}" Text="ВИДИМОСТЬ ВКЛАДОК"/>
                                        <Border Style="{StaticResource SettingsRow}"><Grid><TextBlock Text="Показывать «Уведомления»" FontSize="14.5" VerticalAlignment="Center"/><ToggleButton x:Name="ShowNotificationsTabToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Checked="TabVisibility_Changed" Unchecked="TabVisibility_Changed"/></Grid></Border>
                                        <TextBlock Text="Эту вкладку нельзя скрыть, чтобы настройки всегда оставались доступны." Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,0,4"/>
                                    </StackPanel></Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

