                    <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- List rows without the system blue selection highlight. -->
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Palette follows amazing-rp.ru: near-black, off-white text, red accent, gold CTA -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#08080A"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#0D0D10"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#121215"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#1A1A1E"/>
        <SolidColorBrush x:Key="RowBgBrush" Color="#18181C"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#1E1E23"/>
        <SolidColorBrush x:Key="BorderThemeBrush" Color="#26262C"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#33333A"/>
        <SolidColorBrush x:Key="SwitchTrackBrush" Color="#2E2E35"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EBECF3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2E2E"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PositiveBrush" Color="#35D07F"/>
        <SolidColorBrush x:Key="NegativeBrush" Color="#FF5C63"/>
        <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9A7434" Offset="0"/>
            <GradientStop Color="#FFECC2" Offset="0.55"/>
            <GradientStop Color="#C9A25E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ArtFadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0008080A" Offset="0.45"/>
            <GradientStop Color="#F008080A" Offset="1"/>
        </LinearGradientBrush>
